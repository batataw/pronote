# Unité systemd. Adapter User et WorkingDirectory, puis :
#   sudo cp scripts/pronote-extractor.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pronote-extractor
[Unit]
Description=pronote-extractor (extraction d'emploi du temps PRONOTE)
After=network.target

[Service]
Type=simple
User=pronote
WorkingDirectory=/opt/pronote-extractor
ExecStart=/opt/pronote-extractor/.venv/bin/uvicorn pronote_extractor.api:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
